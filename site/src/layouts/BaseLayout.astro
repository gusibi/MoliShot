---
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  page: 'home' | 'about' | 'changelog';
}

const { page } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <SEO pageType={page} />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    data-page={page}
    class="font-sans bg-surf dark:bg-[#0a0a0a] text-[#1a1a1a] dark:text-[#e0e0e0] min-h-screen overflow-x-hidden antialiased leading-relaxed"
  >
    <!-- Nav -->
    <nav
      class="fixed top-0 inset-x-0 z-50 border-b backdrop-blur-xl transition-colors bg-surf/85 dark:bg-[#0a0a0a]/85 border-bord dark:border-[#222]"
    >
      <div class="max-w-6xl mx-auto px-8 h-16 flex items-center justify-between">
        <a
          href="/"
          class="flex items-center gap-3 font-mono font-bold text-lg text-[#1a1a1a] dark:text-[#e0e0e0]"
        >
          <svg class="w-7 h-7" viewBox="0 0 1024 1024" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <radialGradient id="ng" cx="35%" cy="30%" r="75%" fx="30%" fy="25%">
                <stop offset="0%" stop-color="#FFB088" />
                <stop offset="100%" stop-color="#F07855" />
              </radialGradient>
            </defs>
            <rect width="1024" height="1024" rx="230" fill="url(#ng)" />
            <rect x="88" y="152" width="548" height="720" rx="76" fill="#F7F4EF" opacity="0.9" />
            <rect x="688" y="268" width="248" height="168" rx="84" fill="#FFFFFF" opacity="0.8" />
            <rect x="688" y="508" width="312" height="168" rx="84" fill="#FCFAF5" opacity="0.7" />
          </svg>
          MoliShot
        </a>
        <Nav page={page} />
      </div>
    </nav>

    <slot />

    <!-- Footer -->
    <Footer />
  </body>
</html>

